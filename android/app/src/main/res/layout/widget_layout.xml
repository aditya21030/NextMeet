<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Native XML Card (Clean Pink & White NextMeet Design System) -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Area: Tap opens Home Screen -->
        <LinearLayout
            android:id="@+id/widget_header_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Row: Distance label + Partner battery pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE"
                    android:textColor="#7A6672"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_pill_mint"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="🔋 87% • Online now"
                    android:textColor="#1F7A4F"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Middle Row: Big Distance & Partner / Reunion Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_distance"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="1,506 km"
                    android:textColor="#D81B6A"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_partner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ Bibaaa"
                    android:textColor="#2B1B26"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginRight="6dp" />

                <!-- Countdown Pill: Tappable to open Plan / Reunion -->
                <TextView
                    android:id="@+id/widget_countdown_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_pill_pink"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="7 DAYS"
                    android:textColor="#D81B6A"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Route Subtitle (Defaults to Cities, switches to feedback on button tap) -->
            <TextView
                android:id="@+id/widget_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Howrah to Ratangarh"
                android:textColor="#7A6672"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp"
                android:maxLines="1" />

            <!-- Dynamic Feedback message on touch -->
            <TextView
                android:id="@+id/widget_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D81B6A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="1dp"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Bottom: Dedicated Interactive Touch Actions Bar (WORKABLE FROM WIDGET!) -->
        <LinearLayout
            android:id="@+id/widget_actions_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center">

            <!-- Miss You Button -->
            <TextView
                android:id="@+id/btn_action_miss"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_pink"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="❤️ Miss"
                android:textColor="#D81B6A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginRight="4dp" />

            <!-- Hug Button -->
            <TextView
                android:id="@+id/btn_action_hug"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_purple"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="🤗 Hug"
                android:textColor="#7B5CF0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginRight="4dp" />

            <!-- Touch Button -->
            <TextView
                android:id="@+id/btn_action_touch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_yellow"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="⚡ Touch"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginRight="4dp" />

            <!-- Sync Button -->
            <TextView
                android:id="@+id/btn_action_sync"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_mint"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="💓 Sync"
                android:textColor="#1F7A4F"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
