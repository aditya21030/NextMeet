<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Native XML layout (Clean Pink & White NextMeet Design System) -->
    <LinearLayout
        android:id="@+id/widget_native_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="visible">

        <!-- Top Row: Distance label + Partner battery pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="DISTANCE"
                android:textColor="#7A6672"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/widget_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_mint"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🔋 87% • Online now"
                android:textColor="#1F7A4F"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Distance Text -->
        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1,506 km"
            android:textColor="#D81B6A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp" />

        <!-- Route & Cities -->
        <TextView
            android:id="@+id/widget_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Howrah to Ratangarh"
            android:textColor="#7A6672"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:maxLines="1" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Row: Partner Name & Countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_partner_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="❤️ Bibaaa"
                android:textColor="#2B1B26"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_countdown_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_pink"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="7 DAYS"
                android:textColor="#D81B6A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Flutter-Rendered Pixel-Perfect Widget Image (Overlays when available) -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:visibility="gone" />

</RelativeLayout>
