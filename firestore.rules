rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Returns true if the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the user's UID is in the participant list.
    function isMemberOfData(data) {
      return isAuthenticated() && (request.auth.uid in data.uids);
    }

    // Case 2: Checking access to sub-collections via parent relationship
    function isMemberOfRel(relId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/relationships/$(relId)).data.uids
      );
    }

    // Global Admin Check (Replace with your actual UID)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "PxveDeYZD1MvubUIqP6FkZJKYXq1"
      );
    }

    // Relationship Documents
    match /relationships/{relId} {
      // Any authenticated user can start a journey (create a relationship document).
      // They also need to READ it to verify the invite details before joining.
      allow create, read: if isAuthenticated();
      
      // Update logic:
      // 1. Existing members can update.
      // 2. Joining partner can update once (transition from 'waiting' to 'active').
      allow update: if isMemberOfData(resource.data) 
                    || isAdmin()
                    || (isAuthenticated() && resource.data.status == 'waiting' && request.resource.data.status == 'active' && (request.auth.uid in request.resource.data.uids));
      
      // Prevent deletion.
      allow delete: if false;

      // Sub-collections (memories, messages, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isMemberOfRel(relId) || isAdmin();
      }
    }

    // Invites
    match /invites/{code} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Allows changing status to 'accepted'
      allow delete: if isAuthenticated() && (resource.data.creatorUid == request.auth.uid || isAdmin());
    }

    // Stats and Administrative
    match /system_stats/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /users_directory/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (uid == request.auth.uid || isAdmin());
    }

    match /pending_relationships/{relId} {
      allow read, write: if isAuthenticated();
    }

    match /accepted_relationships/{relId} {
      allow read, write: if isAuthenticated(); // App or AdminHub can record the connection
    }
    
    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
