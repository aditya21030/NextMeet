rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Relationship Documents
    match /relationships/{relId} {
      allow create, read, update: if true;
      allow delete: if false;

      // Sub-collections (memories, messages, calendar, etc.)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Invites
    match /invites/{code} {
      allow read, create, update, delete: if true;
    }

    // Stats and Administrative
    match /system_stats/{docId} {
      allow read, write: if true;
    }

    match /users_directory/{uid} {
      allow read, write: if true;
    }

    match /pending_relationships/{relId} {
      allow read, write: if true;
    }

    match /accepted_relationships/{relId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
