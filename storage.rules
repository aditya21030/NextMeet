rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow couple relationships to upload and view photos, memories, and voice notes.
    match /relationships/{relId}/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Fallback: authenticated access for any other path.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
